{
  "name": "rubstack",
  "displayName": "rubstack",
  "version": "0.1.2",
  "description": "Rubén's software factory for Claude Code: a skill chain from idea to shipped product, plus utility skills and guard hooks. Works the same locally and in Claude Code cloud sessions.",
  "author": {
    "name": "Ruben Glez"
  },
  "homepage": "https://github.com/RubenGlez/rubstack",
  "repository": "https://github.com/RubenGlez/rubstack",
  "license": "MIT",
  "skills": "./skills/",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/block-dangerous-git.sh\"" },
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/block-prototype-commit.sh\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/lint-design.sh\"" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/session-start.sh\"", "timeout": 120 }
        ]
      }
    ]
  }
}
